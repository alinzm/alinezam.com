---
import BaseHead from '../components/BaseHead.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500&family=Space+Mono&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-[#0c0c0c] font-['Space_Grotesk',sans-serif] text-[#f2f0eb] [&_a:focus-visible]:outline [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-[#e8542f] [&_button:focus-visible]:outline [&_button:focus-visible]:outline-2 [&_button:focus-visible]:outline-offset-4 [&_button:focus-visible]:outline-[#e8542f]">
		<header class="border-b border-white/[0.14]">
			<nav class="flex items-center justify-between gap-3 px-4 py-4 sm:gap-6 sm:px-8 sm:py-5">
				<a
					href="/"
					class="shrink-0 font-['Anton',sans-serif] text-base tracking-[0.05em] text-[#f2f0eb] no-underline sm:text-lg sm:tracking-[0.06em]"
				>ALI NEZAMOLMALEKI</a>
				<div class="flex shrink-0 items-center gap-3 text-[11px] tracking-[0.1em] sm:gap-7 sm:text-[13px] sm:tracking-[0.14em]">
					<a href="/photos" class="text-[#f2f0eb] no-underline transition-opacity hover:opacity-70 motion-reduce:transition-none">WORK</a>
					<a href="/about" class="text-[#f2f0eb] no-underline transition-opacity hover:opacity-70 motion-reduce:transition-none">ABOUT</a>
					<a
						href="https://linkedin.com/in/alinzm"
						target="_blank"
						rel="noopener noreferrer"
						class="border border-[#f2f0eb] px-2.5 py-1.5 text-[#f2f0eb] no-underline transition-colors hover:bg-[#f2f0eb] hover:text-[#0c0c0c] motion-reduce:transition-none sm:px-3.5"
					>CONTACT</a>
				</div>
			</nav>
		</header>

		<slot />

		<footer
			class="flex flex-col gap-2 px-5 py-6 font-['Space_Mono',monospace] text-[11px] text-[#f2f0eb]/40 sm:flex-row sm:justify-between sm:px-8"
		>
			<span>&copy; {new Date().getFullYear()} ALI NEZAMOLMALEKI</span>
			<span class="flex gap-3">
				<a href="https://github.com/alinzm" target="_blank" rel="noopener noreferrer" class="text-[#f2f0eb]/40 no-underline transition-colors hover:text-[#f2f0eb] motion-reduce:transition-none">GITHUB</a>
				<span aria-hidden="true">·</span>
				<a href="https://linkedin.com/in/alinzm" target="_blank" rel="noopener noreferrer" class="text-[#f2f0eb]/40 no-underline transition-colors hover:text-[#f2f0eb] motion-reduce:transition-none">LINKEDIN</a>
				<span aria-hidden="true">·</span>
				<a href="https://x.com/alinzm" target="_blank" rel="noopener noreferrer" class="text-[#f2f0eb]/40 no-underline transition-colors hover:text-[#f2f0eb] motion-reduce:transition-none">X</a>
			</span>
		</footer>
	</body>
</html>
