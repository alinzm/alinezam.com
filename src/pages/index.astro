---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-6 py-16">
			<section class="mb-16">
				<h1 class="mb-4 text-4xl font-bold tracking-tight text-zinc-900">
					Hi, I'm Ali Nezam
				</h1>
				<p class="max-w-2xl text-lg leading-relaxed text-zinc-600">
					Co-Founder & CTO at <a href="https://faircado.com" target="_blank" rel="noopener noreferrer">Faircado</a>,
					the AI-powered sustainable shopping assistant. Organic growth leader with 14+ years
					of experience scaling search-driven acquisition. Based in Berlin.
				</p>
				<p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600">
					Currently building with AI — from agentic workflows to Generative Engine Optimization (GEO).
					I also run <a href="https://rankguides.com" target="_blank" rel="noopener noreferrer">RankGuides</a>,
					a growth consulting agency.
				</p>
				<div class="mt-8 flex gap-4">
					<a href="/about" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white no-underline transition-opacity hover:opacity-80">
						About me
					</a>
					<a href="/blog" class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 px-4 py-2 text-sm font-medium text-zinc-700 no-underline transition-colors hover:border-zinc-300 hover:bg-zinc-50">
						Read the blog
					</a>
				</div>
			</section>

			<section class="mb-16">
				<h2 class="mb-6 text-xl font-semibold text-zinc-900">What I'm Working On</h2>
				<div class="space-y-4">
					<div class="rounded-lg border border-zinc-100 p-5">
						<h3 class="font-medium text-zinc-900">Faircado</h3>
						<p class="mt-1 text-sm text-zinc-500">AI-powered browser extension that finds second-hand alternatives while you shop online. Fast Company's Most Innovative Companies 2025. Slush 100 winner.</p>
					</div>
					<div class="rounded-lg border border-zinc-100 p-5">
						<h3 class="font-medium text-zinc-900">RankGuides</h3>
						<p class="mt-1 text-sm text-zinc-500">Growth consulting agency — SEO, GEO (Generative Engine Optimization), Google Ads, and AI-first optimization strategies.</p>
					</div>
					<div class="rounded-lg border border-zinc-100 p-5">
						<h3 class="font-medium text-zinc-900">Open Source</h3>
						<p class="mt-1 text-sm text-zinc-500">Building open-source tools like Open Accelerator (startup playbook for founders) and LifeSheet (auto time tracking with AI).</p>
					</div>
				</div>
			</section>

			<section>
				<h2 class="mb-8 text-xl font-semibold text-zinc-900">Recent Posts</h2>
				<ul class="space-y-6">
					{posts.slice(0, 5).map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="group block no-underline">
								<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
									<time class="shrink-0 text-sm tabular-nums text-zinc-400">
										<FormattedDate date={post.data.pubDate} />
									</time>
									<h3 class="text-base font-medium text-zinc-900 transition-colors group-hover:text-zinc-600">
										{post.data.title}
									</h3>
								</div>
								{post.data.description && (
									<p class="mt-1 text-sm text-zinc-500">
										{post.data.description}
									</p>
								)}
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
