---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About - Ali Nezamolmaleki" description="Founder of ViralDeck. Organic growth leader and software engineer based in Berlin." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-6 py-16">
			<h1 class="mb-8 text-3xl font-bold tracking-tight text-zinc-900">About</h1>

			<div class="space-y-6 text-zinc-600 leading-relaxed">
				<p>
					I'm Ali Nezamolmaleki — founder, software engineer, and organic growth leader based in Berlin
					with over 14 years of experience scaling search-driven acquisition across global markets.
				</p>

				<p>
					I'm the founder of <a href="https://viraldeck.io">ViralDeck</a>, a SaaS platform for brands
					to track UGC creator campaigns across TikTok, Instagram and YouTube. Previously I co-founded
					<a href="https://faircado.com">Faircado</a>, an AI-powered sustainable shopping assistant backed by
					<strong class="text-zinc-900">Accel, Lightspeed, General Catalyst, NEA, and Northzone</strong>.
					Faircado was named one of <strong class="text-zinc-900">Fast Company's Most Innovative Companies 2025</strong>
					and won the <strong class="text-zinc-900">Slush 100 competition</strong>.
				</p>

				<h2 class="pt-4 text-xl font-semibold text-zinc-900">What I Do</h2>

				<p>
					I sit at the intersection of engineering and growth. My background spans full-stack development
					(TypeScript, React, Next.js, Node.js, Python) and organic growth strategy (SEO, GEO, content,
					technical audits). I believe the best growth is built into the product.
				</p>

				<p>
					I also run <a href="https://rankguides.com">RankGuides</a>, a growth consulting agency focused on
					SEO, Generative Engine Optimization (GEO), and Google Ads. I work directly with clients — no
					account managers, no fluff.
				</p>

				<h2 class="pt-4 text-xl font-semibold text-zinc-900">Career Highlights</h2>

				<ul class="list-disc space-y-3 pl-6">
					<li>
						<strong class="text-zinc-900">ViralDeck</strong> — Founder (2026–present).
						Building creator analytics infrastructure for real-time campaign performance across TikTok, Instagram, and YouTube.
					</li>
					<li>
						<strong class="text-zinc-900">Faircado</strong> — Technical Co-Founder (2020–2026).
						Scaled to 500K organic users in year one. Built and led a team of 25. Raised EUR 3M from Accel, Lightspeed, General Catalyst.
					</li>
					<li>
						<strong class="text-zinc-900">AirHelp</strong> — Head of Global Search (2017–2020).
						Managed a 7-figure SEO budget across 24 markets with 350% ROI.
					</li>
				</ul>

				<h2 class="pt-4 text-xl font-semibold text-zinc-900">Current Focus</h2>

				<ul class="list-disc space-y-3 pl-6">
					<li>Building <a href="https://viraldeck.io">ViralDeck</a> — UGC creator campaign analytics for brands</li>
					<li>Agentic workflows — AI agent teams (Claude, LLMs) for business automation</li>
					<li>Generative Engine Optimization (GEO) — optimizing for AI-generated search results</li>
					<li>Multiple SaaS products: SimpleUTM, RankGuides Score, ExtensionPedia</li>
				</ul>

				<h2 class="pt-4 text-xl font-semibold text-zinc-900">Community</h2>

				<p>
					Member of <a href="https://www.2hearts.club/">2hearts</a>, a non-profit tech community
					supporting people with immigration backgrounds in the tech industry.
				</p>

				<h2 class="pt-4 text-xl font-semibold text-zinc-900">Get in Touch</h2>

				<p>
					I'm always happy to chat about growth, AI, startups, or open-source.
					Find me on <a href="https://linkedin.com/in/alinzm">LinkedIn</a>,
					<a href="https://x.com/alinzm">X</a>,
					<a href="https://github.com/alinzm">GitHub</a>,
					or email me at <a href="mailto:hi@alinzm.com">hi@alinzm.com</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
