---
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import photosData from '../../data/photos.json';
import { resolvePhotoSrc } from '../../lib/photos';

export function getStaticPaths() {
	return photosData.projects.map((project, index) => ({
		params: { project: project.slug },
		props: { project, index },
	}));
}

const { project, index } = Astro.props;
const projects = photosData.projects;
const next = projects[(index + 1) % projects.length];
const projectNumber = String(index + 1).padStart(3, '0');

const photos = project.photos.map((photo) => ({
	...photo,
	src: resolvePhotoSrc(photo.src, photosData.baseUrl),
}));
---

<PhotoLayout title={`${project.title} - Photos - Ali Nezamolmaleki`} description={project.description}>
	<main>
		<section class="px-5 pb-8 pt-10 sm:px-8 sm:pt-14">
			<nav
				class="mb-4 font-['Space_Mono',monospace] text-[11px] tracking-[0.2em] text-[#f2f0eb]/45"
				aria-label="Breadcrumb"
			>
				<a href="/photos" class="text-[#f2f0eb]/45 no-underline transition-colors hover:text-[#f2f0eb] motion-reduce:transition-none">PROJECTS</a>
				<span aria-hidden="true"> / </span>{projectNumber}
			</nav>
			<h1
				class:list={[
					"font-['Anton',sans-serif] text-[clamp(44px,10vw,110px)] uppercase leading-[0.9] tracking-[-0.01em] [text-wrap:balance]",
					project.accent ? 'text-[#e8542f]' : 'text-[#f2f0eb]',
				]}
			>
				{project.title}
			</h1>
			<div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<p class="max-w-[380px] text-[15px] leading-[1.55] text-[#f2f0eb]/70">{project.description}</p>
				<p class="font-['Space_Mono',monospace] text-[11px] text-[#f2f0eb]/45">
					{project.meta} · {String(photos.length).padStart(2, '0')} FRAMES
				</p>
			</div>
		</section>

		<section class="px-5 sm:px-8" aria-label={`${project.title} photos`}>
			<div class="columns-2 gap-1 sm:columns-3" id="photo-grid">
				{photos.map((photo, i) => (
					<button
						type="button"
						class="group mb-1 block w-full cursor-zoom-in break-inside-avoid overflow-hidden border-0 bg-[#141414] p-0"
						data-index={i}
						aria-label={`View photo: ${photo.alt}`}
					>
						<img
							src={photo.src}
							alt={photo.alt}
							width={photo.width}
							height={photo.height}
							loading={i < 6 ? 'eager' : 'lazy'}
							decoding="async"
							class="block h-auto w-full rounded-none transition-opacity group-hover:opacity-80 motion-reduce:transition-none"
						/>
					</button>
				))}
			</div>
		</section>

		<section class="mt-12 border-t border-white/[0.14] px-5 sm:px-8">
			<a
				href={`/photos/${next.slug}`}
				class="group flex flex-col justify-between gap-1 py-6 no-underline sm:flex-row sm:items-baseline"
			>
				<span class="font-['Space_Mono',monospace] text-[11px] tracking-[0.2em] text-[#f2f0eb]/45">
					NEXT PROJECT
				</span>
				<span
					class:list={[
						"font-['Anton',sans-serif] text-[clamp(26px,5vw,40px)] uppercase transition-opacity group-hover:opacity-70 motion-reduce:transition-none",
						next.accent ? 'text-[#e8542f]' : 'text-[#f2f0eb]',
					]}
				>
					{next.title} <span aria-hidden="true">→</span>
				</span>
			</a>
		</section>
	</main>

	<dialog
		id="lightbox"
		class="m-auto h-full max-h-full w-full max-w-full bg-transparent p-0 backdrop:bg-[#0c0c0c]/95"
		aria-label="Photo viewer"
	>
		<div class="flex h-full w-full items-center justify-center p-4 sm:p-10" id="lightbox-backdrop">
			<img id="lightbox-img" src="" alt="" class="max-h-full max-w-full rounded-none object-contain" />
		</div>
		<button
			type="button"
			id="lightbox-close"
			aria-label="Close photo viewer"
			class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center border border-white/30 bg-[#0c0c0c]/60 text-[#f2f0eb] transition-colors hover:bg-[#f2f0eb] hover:text-[#0c0c0c] motion-reduce:transition-none"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
				<path d="M3 3l10 10M13 3L3 13" />
			</svg>
		</button>
		<button
			type="button"
			id="lightbox-prev"
			aria-label="Previous photo"
			class="absolute left-4 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center border border-white/30 bg-[#0c0c0c]/60 text-[#f2f0eb] transition-colors hover:bg-[#f2f0eb] hover:text-[#0c0c0c] motion-reduce:transition-none"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M10 3L5 8l5 5" />
			</svg>
		</button>
		<button
			type="button"
			id="lightbox-next"
			aria-label="Next photo"
			class="absolute right-4 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center border border-white/30 bg-[#0c0c0c]/60 text-[#f2f0eb] transition-colors hover:bg-[#f2f0eb] hover:text-[#0c0c0c] motion-reduce:transition-none"
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M6 3l5 5-5 5" />
			</svg>
		</button>
		<p
			id="lightbox-counter"
			class="absolute bottom-4 left-1/2 -translate-x-1/2 font-['Space_Mono',monospace] text-xs tabular-nums text-[#f2f0eb]/60"
		></p>
	</dialog>

	<script>
		const grid = document.getElementById('photo-grid');
		const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
		const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
		const counter = document.getElementById('lightbox-counter');
		const backdrop = document.getElementById('lightbox-backdrop');

		if (grid && lightbox && img && counter && backdrop) {
			const buttons = [...grid.querySelectorAll<HTMLButtonElement>('button[data-index]')];
			const photos = buttons.map((b) => b.querySelector('img')!);
			let current = 0;

			const show = (index: number) => {
				current = (index + photos.length) % photos.length;
				img.src = photos[current].src;
				img.alt = photos[current].alt;
				counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(photos.length).padStart(2, '0')}`;
			};

			buttons.forEach((button) => {
				button.addEventListener('click', () => {
					show(Number(button.dataset.index));
					lightbox.showModal();
				});
			});

			document.getElementById('lightbox-close')?.addEventListener('click', () => lightbox.close());
			document.getElementById('lightbox-prev')?.addEventListener('click', () => show(current - 1));
			document.getElementById('lightbox-next')?.addEventListener('click', () => show(current + 1));

			backdrop.addEventListener('click', (e) => {
				if (e.target === backdrop) lightbox.close();
			});

			lightbox.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') show(current - 1);
				if (e.key === 'ArrowRight') show(current + 1);
			});
		}
	</script>
</PhotoLayout>
