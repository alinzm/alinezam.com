---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Posts about startups, engineering, and building in public." />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-6 py-16">
			<h1 class="mb-8 text-3xl font-bold tracking-tight text-zinc-900">Blog</h1>
			<ul class="space-y-6">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="group block no-underline">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
								<time class="shrink-0 text-sm tabular-nums text-zinc-400">
									<FormattedDate date={post.data.pubDate} />
								</time>
								<h2 class="text-base font-medium text-zinc-900 transition-colors group-hover:text-zinc-600">
									{post.data.title}
								</h2>
							</div>
							{post.data.description && (
								<p class="mt-1 text-sm text-zinc-500">
									{post.data.description}
								</p>
							)}
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
